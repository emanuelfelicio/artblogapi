# =============================================================================
# Application
# =============================================================================
APP_ENV=development          # development | production
LOG_LEVEL=debug              # debug | info | warn | error
PORT=8080

# =============================================================================
# JWT
# =============================================================================
JWT_ISSUER=artblogapi
JWT_SECRET=long-random-string 

# =============================================================================
# Refresh Token Cookie
# =============================================================================
REFRESH_TOKEN_COOKIE_DOMAIN=   # e.g. example.com (leave empty for localhost)
REFRESH_TOKEN_COOKIE_SECURE=false 

# =============================================================================
# Database (application)
# =============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/artblog?sslmode=disable

# Docker-compose variables (used by the postgres container)
POSTGRES_DB=artblog
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# =============================================================================
# Goose (migrations CLI)
# =============================================================================
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/artblog?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations

# Path used by integration tests (relative to the test package directory)
GOOSE_DIR=../../db/migrations

# =============================================================================
# Storage (S3 / MinIO / R2) - S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY are also used by docker-compose (MinIO)
# =============================================================================
# URL pública para exibição de mídias. Se omitido, deriva automaticamente de S3_ENDPOINT/S3_BUCKET.
# Em produção com CDN: STORAGE_PUBLIC_URL=https://cdn.artblog.io
STORAGE_PUBLIC_URL=http://localhost:9000/artblog
DEFAULT_AVATAR_URL=http://localhost:9000/artblog/defaults/avatar.png
DEFAULT_BANNER_URL=http://localhost:9000/artblog/defaults/banner.png
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artblog
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PRESIGN_TTL=15m
S3_FORCE_PATH_STYLE=true

# =============================================================================
# Storage Worker
# =============================================================================
STORAGE_WORKER_CONCURRENCY=3
STORAGE_WORKER_TICKER_INTERVAL=60s
STORAGE_WORKER_STALE_THRESHOLD=30s
STORAGE_WORKER_HEARTBEAT_INTERVAL=10s
STORAGE_WORKER_BACKOFF_INTERVAL=10s
STORAGE_MAX_RETRIES=3


