# =============================================================================
# Application
# =============================================================================
APP_ENV=development          # development | production
LOG_LEVEL=debug              # debug | info | warn | error
PORT=8080

# =============================================================================
# JWT
# =============================================================================
JWT_ISSUER=artblogapi
JWT_SECRET=long-random-string 

# =============================================================================
# Refresh Token Cookie
# =============================================================================
REFRESH_TOKEN_COOKIE_DOMAIN=   # e.g. example.com (leave empty for localhost)
REFRESH_TOKEN_COOKIE_SECURE=false 

# =============================================================================
# Database (application)
# =============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/artblog?sslmode=disable

# Docker-compose variables (used by the postgres container)
POSTGRES_DB=artblog
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# =============================================================================
# Goose (migrations CLI)
# =============================================================================
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/artblog?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations

# Path used by integration tests (relative to the test package directory)
GOOSE_DIR=../../db/migrations
